# ProspectIQ V0 configuration. Copy to .env and fill locally.
# Never commit real credentials.

# --- Application ---
PROSPECTIQ_ENV=development
PROSPECTIQ_LOG_LEVEL=INFO
PROSPECTIQ_SECRET_KEY=replace-with-a-long-random-string
PROSPECTIQ_API_HOST=0.0.0.0
PROSPECTIQ_API_PORT=8000

# Internal single-tenant identity (V0). Future SaaS will resolve this from auth.
PROSPECTIQ_INTERNAL_TENANT_ID=00000000-0000-0000-0000-000000000001
PROSPECTIQ_INTERNAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000002
PROSPECTIQ_INTERNAL_USER_ID=00000000-0000-0000-0000-000000000003

# --- PostgreSQL ---
PROSPECTIQ_DATABASE_URL=postgresql+asyncpg://prospectiq:prospectiq@localhost:5432/prospectiq

# --- Redis (optional dispatch/notify; Postgres is the durable job store) ---
PROSPECTIQ_REDIS_URL=redis://localhost:6379/0

# --- AI provider (leave empty until a provider is configured) ---
PROSPECTIQ_AI_PROVIDER=none
PROSPECTIQ_AI_API_KEY=
PROSPECTIQ_AI_MODEL=

# Official LinkedIn integration remains disabled unless an authorized
# integration is explicitly enabled. Do not put LinkedIn session cookies here.
PROSPECTIQ_OFFICIAL_LINKEDIN_ENABLED=false
PROSPECTIQ_OFFICIAL_LINKEDIN_CLIENT_ID=
PROSPECTIQ_OFFICIAL_LINKEDIN_CLIENT_SECRET=

# Controlled public-web fetch limits. Do not raise these to "unlimited".
PROSPECTIQ_FETCH_CONNECT_TIMEOUT_SECONDS=5
PROSPECTIQ_FETCH_READ_TIMEOUT_SECONDS=10
PROSPECTIQ_FETCH_TOTAL_TIMEOUT_SECONDS=15
PROSPECTIQ_FETCH_MAX_RESPONSE_BYTES=1048576
PROSPECTIQ_FETCH_MAX_REDIRECTS=3
PROSPECTIQ_FETCH_USER_AGENT=ProspectIQ/0.1 (+internal-company-research)

# Permitted company discovery provider (SerpAPI search API). Leave disabled until configured.
PROSPECTIQ_DISCOVERY_PROVIDER=none
PROSPECTIQ_SERPAPI_API_KEY=
PROSPECTIQ_DISCOVERY_MAX_CANDIDATES=20
PROSPECTIQ_DISCOVERY_PAGE_SIZE=10
PROSPECTIQ_DISCOVERY_MAX_PAGES=2
PROSPECTIQ_DISCOVERY_TIMEOUT_SECONDS=15

# Optional company news/funding provider (uses SerpAPI Google News when set to serpapi).
PROSPECTIQ_NEWS_PROVIDER=none
PROSPECTIQ_NEWS_MAX_RESULTS=10

# Frontend (Next.js) talks to the API only. Never expose provider secrets.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
